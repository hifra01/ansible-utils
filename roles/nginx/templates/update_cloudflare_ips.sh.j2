#!/bin/bash
set -euo pipefail

TARGET_CF="{{ nginx_config_dir }}/conf.d/cloudflare.conf"
TARGET_ALLOW="{{ nginx_config_dir }}/allow-cloudflare-only.conf"

TEMP_CF=$(mktemp)
TEMP_ALLOW=$(mktemp)

cleanup() {
    rm -f "$TEMP_CF" "$TEMP_ALLOW"
}
trap cleanup EXIT

echo "Fetching Cloudflare IPv4 and IPv6 ranges..."
cf_ips_v4=$(curl -fsSL "https://www.cloudflare.com/ips-v4/") || {
    echo "Failed to fetch Cloudflare IPv4 ranges" >&2
    exit 1
}
cf_ips_v6=$(curl -fsSL "https://www.cloudflare.com/ips-v6/") || {
    echo "Failed to fetch Cloudflare IPv6 ranges" >&2
    exit 1
}

if [ -z "$cf_ips_v4" ] || [ -z "$cf_ips_v6" ]; then
    echo "Error: Cloudflare IP lists are empty." >&2
    exit 1
fi

cat << 'EOF' > "$TEMP_CF"
# Generated dynamically by update_cloudflare_ips.sh
# Do not edit this file manually.

# Local & Trusted Proxies
EOF

{% for proxy in nginx_trusted_proxies %}
echo "set_real_ip_from {{ proxy }};" >> "$TEMP_CF"
{% endfor %}

cat << 'EOF' >> "$TEMP_CF"

# Cloudflare IPv4
EOF

echo "$cf_ips_v4" | while IFS= read -r ip; do
    [ -n "$ip" ] || continue
    echo "set_real_ip_from $ip;" >> "$TEMP_CF"
done

cat << 'EOF' >> "$TEMP_CF"

# Cloudflare IPv6
EOF

echo "$cf_ips_v6" | while IFS= read -r ip; do
    [ -n "$ip" ] || continue
    echo "set_real_ip_from $ip;" >> "$TEMP_CF"
done

cat << 'EOF' >> "$TEMP_CF"

# Real IP Configuration
real_ip_header CF-Connecting-IP;
real_ip_recursive {{ nginx_real_ip_recursive }};

# Geo IP mapping based on original connecting TCP IP
geo $realip_remote_addr $is_cloudflare {
    default 0;
EOF

{% for proxy in nginx_trusted_proxies %}
echo "    {{ proxy }} 1;" >> "$TEMP_CF"
{% endfor %}

echo "$cf_ips_v4" | while IFS= read -r ip; do
    [ -n "$ip" ] || continue
    echo "    $ip 1;" >> "$TEMP_CF"
done

echo "$cf_ips_v6" | while IFS= read -r ip; do
    [ -n "$ip" ] || continue
    echo "    $ip 1;" >> "$TEMP_CF"
done

cat << 'EOF' >> "$TEMP_CF"
}
EOF

cat << 'EOF' > "$TEMP_ALLOW"
# Deny traffic not originating from Cloudflare or localhost
if ($is_cloudflare = 0) {
    return 403;
}
EOF

mkdir -p "{{ nginx_config_dir }}/conf.d"

BACKUP_CF=""
BACKUP_ALLOW=""
if [ -f "$TARGET_CF" ]; then
    BACKUP_CF=$(mktemp)
    cp "$TARGET_CF" "$BACKUP_CF"
fi
if [ -f "$TARGET_ALLOW" ]; then
    BACKUP_ALLOW=$(mktemp)
    cp "$TARGET_ALLOW" "$BACKUP_ALLOW"
fi

cp "$TEMP_CF" "$TARGET_CF"
chmod 0644 "$TARGET_CF"
cp "$TEMP_ALLOW" "$TARGET_ALLOW"
chmod 0644 "$TARGET_ALLOW"

if nginx -t >/dev/null 2>&1; then
    echo "Nginx configuration test passed."
    if systemctl is-active --quiet nginx 2>/dev/null || service nginx status >/dev/null 2>&1; then
        echo "Reloading Nginx..."
        systemctl reload nginx 2>/dev/null || service nginx reload 2>/dev/null || nginx -s reload 2>/dev/null || true
    fi
    if [ -n "$BACKUP_CF" ]; then
        rm -f "$BACKUP_CF"
    fi
    if [ -n "$BACKUP_ALLOW" ]; then
        rm -f "$BACKUP_ALLOW"
    fi
else
    echo "Nginx configuration test failed! Reverting changes..." >&2
    if [ -n "$BACKUP_CF" ]; then
        mv "$BACKUP_CF" "$TARGET_CF"
    else
        rm -f "$TARGET_CF"
    fi
    if [ -n "$BACKUP_ALLOW" ]; then
        mv "$BACKUP_ALLOW" "$TARGET_ALLOW"
    else
        rm -f "$TARGET_ALLOW"
    fi
    exit 1
fi
