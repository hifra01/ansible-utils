{% endif %}
{% if consul_service.tags is defined %}
{%   set _ = svc.update({'tags': consul_service.tags}) %}
{% endif %}
{% if consul_service.meta is defined %}
{%   set _ = svc.update({'meta': consul_service.meta}) %}
